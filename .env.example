# wms-be environment
PORT=3000
DATABASE_URL=postgres://wms:wms@localhost:55432/wms
# CORS allow-list for browser clients, comma-separated. The default covers the
# web dev server (localhost:3001); extend for deployed frontend origins.
CORS_ORIGIN=http://localhost:3001
# Auth-time reads (sign-in, registration replay) run before any tenant scope
# exists, so they need a connection whose role carries BYPASSRLS (or superuser).
# Falls back to DATABASE_URL when unset — point it at a BYPASSRLS role in any
# deployment where the app role is a non-superuser (review loop 1 decision).
DATABASE_AUTH_URL=
# Secret for HS256 tenant session tokens (>= 16 chars) — Story 1.2 sign-in
JWT_SECRET=replace-me-with-a-long-random-secret  # REPLACE before running — length is validated, this placeholder is NOT a secret
# Outbox relay poll interval in ms (story outbox-relay). Gates the relay worker
# that drains committed outbox_messages through the event bus — leave unset or
# 0 to disable the worker (tests); every deployment must set it or the outbox
# grows unboundedly.
OUTBOX_RELAY_POLL_MS=2000
# Valkey (story 2.3, AD-2): the atomic-decision store for reservations —
# per-(warehouse, sku) reserved counters only, tenant-namespaced. Postgres
# (`reservations`) is the journal truth; counters are rebuilt from it on
# divergence. Required whenever a reservation path runs (boot-validated at
# first use); the reconciliation/reaper paths fail closed without it.
VALKEY_URL=redis://localhost:56379/0
# Reservation reaper poll interval in ms (story 2.3). Gates the sheddable
# worker that expires held reservations past their TTL (and runs the scheduled
# journal-vs-counter parity pass) — leave unset or 0 to disable the worker
# (tests drive the facade directly); every deployment must set it or holds
# never expire and ATP shrinks toward zero.
RESERVATION_REAPER_POLL_MS=2000
