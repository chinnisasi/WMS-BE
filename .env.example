# wms-be environment
PORT=3000
DATABASE_URL=postgres://wms:wms@localhost:55432/wms
# CORS allow-list for browser clients, comma-separated. The default covers the
# web dev server (localhost:3001); extend for deployed frontend origins.
CORS_ORIGIN=http://localhost:3001
# Auth-time reads (sign-in, registration replay) run before any tenant scope
# exists, so they need a connection whose role carries BYPASSRLS (or superuser).
# Falls back to DATABASE_URL when unset — point it at a BYPASSRLS role in any
# deployment where the app role is a non-superuser (review loop 1 decision).
DATABASE_AUTH_URL=
# Secret for HS256 tenant session tokens (>= 16 chars) — Story 1.2 sign-in
JWT_SECRET=replace-me-with-a-long-random-secret  # REPLACE before running — length is validated, this placeholder is NOT a secret
# Outbox relay poll interval in ms (story outbox-relay). Gates the relay worker
# that drains committed outbox_messages through the event bus — leave unset or
# 0 to disable the worker (tests); every deployment must set it or the outbox
# grows unboundedly.
OUTBOX_RELAY_POLL_MS=2000
# Valkey (story 2.3, AD-2): the atomic-decision store for reservations —
# per-(warehouse, sku) reserved counters only, tenant-namespaced. Postgres
# (`reservations`) is the journal truth; counters are rebuilt from it on
# divergence. Required whenever a reservation path runs (boot-validated at
# first use); the reconciliation/reaper paths fail closed without it.
VALKEY_URL=redis://localhost:56379/0
# Reservation reaper poll interval in ms (story 2.3). Gates the sheddable
# worker that expires held reservations past their TTL (and runs the scheduled
# journal-vs-counter parity pass) — leave unset or 0 to disable the worker
# (tests drive the facade directly); every deployment must set it or holds
# never expire and ATP shrinks toward zero.
RESERVATION_REAPER_POLL_MS=2000
# Reconciliation worker poll interval in ms (story 2.2). Gates the sheddable
# worker that drives one (tenant, warehouse) replay-reconciliation cycle per
# tick, oldest-checkpoint-first — leave unset or 0 to disable the worker (tests
# drive `reconcileNext()` directly); unset in production means the bounded
# scan's blind-spot escape (below) never runs and divergences on scopes
# untouched since the checkpoint surface only by manual rebuild.
OUTBOX_RECONCILE_POLL_MS=2000
# Story 10.4: how many BOUNDED reconciliation passes run on a partition before
# the next cycle runs a FULL replay-reconciliation (`replayInTx`) — the bounded
# scan compares only the scopes its checkpoint window touched, so this is the
# scheduled escape from that blind spot, closing it without a second fold
# implementation. "N bounded passes between full passes": 1 alternates. The
# default is 20; a positive integer is required (the boot fails loudly
# otherwise). Trade-off: a smaller N costs more full folds, detects a
# blind-spot divergence sooner.
RECONCILE_FULL_PASS_EVERY=20
# Device secret envelope encryption (story 3.2, AD-15 stand-in): AES-256-GCM
# master key sealing the per-device offline-store key at enrollment — the KMS
# stand-in (swap documented in src/shared/crypto/envelope.ts). Required for
# device enrollment; >= 32 characters.
DEVICE_ENCRYPTION_KEY=replace-me-with-a-long-random-device-encryption-key-32
# Carrier credential envelope encryption (story 4.6b, AD-15): AES-256-GCM
# master key sealing every tenant's carrier API credentials
# (`carrier_connections.credential_sealed`) — the same KMS stand-in as
# DEVICE_ENCRYPTION_KEY (swap documented in src/shared/crypto/envelope.ts),
# but a SEPARATE key on purpose, so carrier secrets and device offline-store
# keys have independent blast radii and rotate independently. Required for
# every carrier connect/rotate (each answers 503
# `carrier-encryption-unavailable` without it); >= 32 characters.
# LOSING THIS KEY MAKES EVERY STORED CARRIER CREDENTIAL UNRECOVERABLE — the
# sealed blobs cannot be opened, and each tenant must re-connect every carrier
# from scratch.
CARRIER_ENCRYPTION_KEY=replace-me-with-a-long-random-carrier-encryption-key-32
# Storage snapshot worker poll interval in ms (story 21-4). Gates the worker
# that writes each client brand's daily closing stock per warehouse and base
# UoM (`storage_snapshots`) — the storage half of client billing. Leave unset
# or 0 to disable it (tests drive the worker's tick directly). A tenant that
# bills client brands must set it (e.g. 300000): with it off, storage reads
# "not measured yet" and no period's storage completes. A day is written only
# 15 minutes after its IST midnight AND once every transaction open at that
# time has finished; a backfill advances 31 days per scope per tick.
STORAGE_SNAPSHOT_POLL_MS=300000
# Replenishment scheduler poll interval in ms (stories 6-1/6-2): one tick runs
# the reorder-breach sweep AND the expiry/aging scan over at most 200
# (tenant, warehouse) scopes (a rotating window past that). Unset or 0 turns
# the scheduler OFF (tests drive the facades directly). Story 9-2 (FR-22):
# the notification panel's reorder-breach entry arrives within 5 minutes of
# the ATP breach ONLY when this is <= 300000 AND every scope fits one tick's
# 200-scope cap — deploy with it set; 60000 leaves headroom for the relay.
REPLENISHMENT_SCHEDULER_POLL_MS=60000
# Mobile pushes (story 9-2b). The push gateway MODE: `unconfigured` (the
# default when unset — every send is recorded in the log and NO network call
# is made; rows read `sent` with gateway `unconfigured`) or `expo` (posts to
# Expo's push API; REQUIRES EXPO_ACCESS_TOKEN — the boot fails without it).
PUSH_GATEWAY=unconfigured
# The Expo access token (expo.dev → account → access tokens) for
# PUSH_GATEWAY=expo. A secret: never commit a real one.
EXPO_ACCESS_TOKEN=
# The Expo push request timeout in ms (default 10000).
PUSH_HTTP_TIMEOUT_MS=10000
# Push sender poll interval in ms. Gates the worker that sends the queued
# pushes (≤ 100 per tenant per tick, one gateway call each). Unset or 0 turns
# it OFF — pushes then queue and are never sent (tests drive the facade).
PUSH_SENDER_POLL_MS=5000
# Wave cutoff sweep poll interval in ms. Gates the worker that raises
# `wave.cutoff_at_risk` (once per planned wave per IST date, inside 60
# minutes of its policy cutoff) — the at-risk push's source. Unset or 0 turns
# it OFF.
WAVE_CUTOFF_SWEEP_POLL_MS=60000
# Audit export poll interval in ms (story 9-3b). Gates the worker that writes
# the owner's requested audit exports (gzipped CSV, up to 1,000,000 events)
# and expires finished ones after 7 days. Unset or 0 turns it OFF — requested
# exports then stay `queued` and the web reads "Preparing…" (tests drive
# `TenancyService.runDueAuditExports` directly).
AUDIT_EXPORT_POLL_MS=10000
# Ledger integrity poll interval in ms (story 9-3c, AD-16). Gates the worker
# that, per warehouse (≤ MAX_LEDGER_INTEGRITY_SCOPES_PER_TICK, default 50, a
# rotating window past that): baselines the pre-0026 prefix once, anchors the
# hash chain's tail in bounded chunks, re-verifies one anchored range in
# rotation, and copies anchors to WORM storage. A chain break raises the
# owner's "Ledger integrity" panel entry. Unset or 0 turns it OFF — nothing is
# anchored and the web reads "Not yet checked". Recommended: 3600000 (hourly).
LEDGER_INTEGRITY_POLL_MS=3600000
# Warehouses per ledger integrity tick (default 50): past it, a rotating window
# reaches every warehouse over successive ticks. A positive integer or the
# boot fails.
MAX_LEDGER_INTEGRITY_SCOPES_PER_TICK=50
# Events per anchor (default 10000): bounds the warehouse lock hold while an
# anchor commits, the verify, and the size of a downloadable proof file.
LEDGER_ANCHOR_MAX_RANGE=10000
# Anchors per warehouse per tick (default 10): the tail advances at most
# MAX_RANGE × CHUNKS events per tick; a backlog catches up over later ticks.
LEDGER_ANCHOR_CHUNKS_PER_TICK=10
# The WORM store for anchor copies: `none` (default — dev and CI: anchors live
# in Postgres only, the web reads "WORM storage not configured") or `s3` (S3
# Object Lock, COMPLIANCE mode). With `s3`, LEDGER_ANCHOR_S3_BUCKET is
# required and a bad region or retention fails the boot. Credentials come from
# the AWS SDK default chain (env, profile, instance role) — never this file.
# Provisioning (not in this repo): a bucket in ap-south-1 created WITH Object
# Lock enabled (versioning is implied); the app role needs s3:PutObject,
# s3:PutObjectRetention, s3:GetObject and s3:GetObjectVersion on
# arn:aws:s3:::<bucket>/ledger-anchors/*, plus s3:ListBucket on
# arn:aws:s3:::<bucket> (without it S3 answers a missing object 403, which
# reads as a transient error instead of a WORM break). A bucket without Object Lock is only
# discovered at the first put: it fails, is logged with its error code, and
# retried every tick (the anchors count as "waiting for WORM copy").
LEDGER_ANCHOR_WORM=none
LEDGER_ANCHOR_S3_BUCKET=
AWS_REGION=ap-south-1
# Object Lock retain-until = anchoredAt + this many days (default 2557, 7 years;
# at most 36500 — a larger value fails the boot).
LEDGER_ANCHOR_RETENTION_DAYS=2557

# Story 6-1a — secure sessions.
# The refresh cookie is `Secure` unless this is `false`. Chrome and Firefox
# accept a Secure cookie on http://localhost; Safari does not — uncomment for
# local Safari only. Never set it in production.
# COOKIE_SECURE=false
# Trusted proxy hops in front of the API (X-Forwarded-For); 0 = use the socket
# address and ignore the header (a client could forge it).
TRUSTED_PROXY_HOPS=0
# Purge ended sessions (> 30 days) and stale attempt counters; unset/0 = OFF.
# Daily in production: 86400000.
SESSION_PURGE_POLL_MS=86400000


# Story 6-1b — two-factor sign-in. AES-256-GCM key sealing every user's
# authenticator secret, and the pepper of their backup codes. REQUIRED: the
# app refuses to boot without it (>= 32 characters). A separate key from the
# device and carrier keys. LOSING IT MAKES EVERY ENROLLED AUTHENTICATOR
# UNREADABLE — every owner must then be reset with `bun run auth:reset-2fa
# <email>` and enrol again.
MFA_ENCRYPTION_KEY=replace-me-with-a-long-random-mfa-encryption-key-32chars
# While rotating MFA_ENCRYPTION_KEY: the old key, so secrets it sealed still
# open (and backup codes it peppered still match). Remove once rotated.
# MFA_ENCRYPTION_KEY_PREVIOUS=
