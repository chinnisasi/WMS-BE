{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "404": {
            "description": "Route not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Liveness check",
        "tags": [
          "health"
        ]
      }
    },
    "/echo": {
      "post": {
        "operationId": "EchoController_echo",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Body is not a JSON object",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "404": {
            "description": "Route not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Echoes the request JSON object back with a timestamp",
        "tags": [
          "echo"
        ]
      }
    }
  },
  "info": {
    "title": "WMS API",
    "description": "Warehouse Management System backend — modular monolith. This document is the contract: web and mobile clients generate typed clients from it (AD-8).",
    "version": "1.0.0",
    "contact": {
      "name": "WMS",
      "url": "https://wms.example.com",
      "email": "api@wms.example.com"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://wms.example.com/license"
    }
  },
  "tags": [],
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "schemas": {
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://wms.example.com/problems/validation-failed"
          },
          "title": {
            "type": "string",
            "example": "Bad Request"
          },
          "status": {
            "type": "number",
            "example": 400
          },
          "code": {
            "type": "string",
            "example": "validation-failed"
          },
          "detail": {
            "type": "string",
            "example": "Echo body must be a JSON object"
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/echo"
          },
          "errors": {
            "example": [
              "key should not exist"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "wms-be"
          },
          "time": {
            "type": "string",
            "example": "2026-09-08T00:00:00.000Z"
          }
        },
        "required": [
          "status",
          "service",
          "time"
        ]
      },
      "EchoResponse": {
        "type": "object",
        "properties": {
          "echoed": {
            "type": "object",
            "additionalProperties": true
          },
          "time": {
            "type": "string",
            "example": "2026-09-08T00:00:00.000Z"
          }
        },
        "required": [
          "echoed",
          "time"
        ]
      }
    }
  }
}
