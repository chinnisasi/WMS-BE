{
  "openapi": "3.0.0",
  "paths": {
    "/tenants": {
      "post": {
        "operationId": "TenancyController_register",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Client-generated ULID key; replays return the original response",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 26,
              "maxLength": 26,
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterTenantDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantRegistrationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing or malformed Idempotency-Key, or invalid body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "409": {
            "description": "Owner email already registered (duplicate-email)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "422": {
            "description": "Idempotency key reused with a different payload (idempotency-key-reuse)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Registers a tenant with its Owner user",
        "tags": [
          "tenancy"
        ]
      }
    },
    "/tenants/sign-in": {
      "post": {
        "operationId": "TenancyController_signIn",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "401": {
            "description": "Unknown email or wrong password (unauthenticated)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Verifies the password and issues a short-lived session token",
        "tags": [
          "tenancy"
        ]
      }
    },
    "/tenants/{tenantId}/warehouses": {
      "post": {
        "operationId": "TenancyController_createWarehouse",
        "parameters": [
          {
            "name": "tenantId",
            "required": true,
            "in": "path",
            "description": "Owning tenant (must match the session)",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Client-generated ULID key; replays return the original response",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 26,
              "maxLength": 26,
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWarehouseDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WarehouseResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing or malformed Idempotency-Key, or invalid body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "403": {
            "description": "Session belongs to another tenant (permission-denied)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "409": {
            "description": "Warehouse code already exists (duplicate-warehouse-code names the code)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "422": {
            "description": "Idempotency key reused with a different payload (idempotency-key-reuse)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Creates a warehouse (code unique per tenant)",
        "tags": [
          "tenancy"
        ]
      },
      "get": {
        "operationId": "TenancyController_listWarehouses",
        "parameters": [
          {
            "name": "tenantId",
            "required": true,
            "in": "path",
            "description": "Owning tenant (must match the session)",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Opaque keyset cursor from the previous page",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 200,
              "example": 50,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WarehouseListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed cursor",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "403": {
            "description": "Session belongs to another tenant (permission-denied)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Lists warehouses (keyset cursor pagination)",
        "tags": [
          "tenancy"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "404": {
            "description": "Route not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Liveness check",
        "tags": [
          "health"
        ]
      }
    },
    "/echo": {
      "post": {
        "operationId": "EchoController_echo",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Body is not a JSON object",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "404": {
            "description": "Route not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Echoes the request JSON object back with a timestamp",
        "tags": [
          "echo"
        ]
      }
    }
  },
  "info": {
    "title": "WMS API",
    "description": "Warehouse Management System backend — modular monolith. This document is the contract: web and mobile clients generate typed clients from it (AD-8).",
    "version": "1.0.0",
    "contact": {
      "name": "WMS",
      "url": "https://wms.example.com",
      "email": "api@wms.example.com"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://wms.example.com/license"
    }
  },
  "tags": [],
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://wms.example.com/problems/validation-failed"
          },
          "title": {
            "type": "string",
            "example": "Bad Request"
          },
          "status": {
            "type": "number",
            "example": 400
          },
          "code": {
            "type": "string",
            "example": "validation-failed"
          },
          "detail": {
            "type": "string",
            "example": "Echo body must be a JSON object"
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/echo"
          },
          "errors": {
            "example": [
              "key should not exist"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "RegisterTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Priya Spices Pvt Ltd",
            "minLength": 1,
            "maxLength": 200
          },
          "ownerEmail": {
            "type": "string",
            "example": "priya@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "correct-horse-battery",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "name",
          "ownerEmail",
          "password"
        ]
      },
      "TenantResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0198f7a2-1b3c-7d4e-8f90-112233445566"
          },
          "name": {
            "type": "string",
            "example": "Priya Spices Pvt Ltd"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "OwnerUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0198f7a2-1b3c-7d4e-8f90-112233445599"
          },
          "email": {
            "type": "string",
            "example": "priya@example.com"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "TenantRegistrationResponse": {
        "type": "object",
        "properties": {
          "tenant": {
            "$ref": "#/components/schemas/TenantResponse"
          },
          "owner": {
            "$ref": "#/components/schemas/OwnerUserResponse"
          }
        },
        "required": [
          "tenant",
          "owner"
        ]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "priya@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "correct-horse-battery",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SignInResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "HS256 session token (15 min), claims: sub + tenant_id"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresInSeconds": {
            "type": "number",
            "example": 900
          },
          "tenant": {
            "$ref": "#/components/schemas/TenantResponse"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresInSeconds",
          "tenant"
        ]
      },
      "CreateWarehouseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "BLR-01",
            "minLength": 1,
            "maxLength": 32
          },
          "name": {
            "type": "string",
            "example": "Whitefield",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "WarehouseResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0198f7a2-1b3c-7d4e-8f90-112233445577"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "example": "0198f7a2-1b3c-7d4e-8f90-112233445566"
          },
          "code": {
            "type": "string",
            "example": "BLR-01"
          },
          "name": {
            "type": "string",
            "example": "Whitefield"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-09-08T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "tenantId",
          "code",
          "name",
          "createdAt"
        ]
      },
      "WarehouseListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WarehouseResponse"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Opaque keyset cursor"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "wms-be"
          },
          "time": {
            "type": "string",
            "example": "2026-09-08T00:00:00.000Z"
          }
        },
        "required": [
          "status",
          "service",
          "time"
        ]
      },
      "EchoResponse": {
        "type": "object",
        "properties": {
          "echoed": {
            "type": "object",
            "additionalProperties": true
          },
          "time": {
            "type": "string",
            "example": "2026-09-08T00:00:00.000Z"
          }
        },
        "required": [
          "echoed",
          "time"
        ]
      }
    }
  }
}
