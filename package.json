{
  "name": "wms-be",
  "version": "0.1.0",
  "private": true,
  "description": "WMS backend — NestJS 12 modular monolith (api + jobs shells)",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/shared/db/migrate.ts",
    "db:migrate:deploy": "bun src/shared/db/migrate-deploy.ts",
    "db:provision-roles": "bun src/shared/db/provision-roles.ts",
    "db:verify": "bun src/shared/db/verify.ts",
    "openapi:export": "bun src/api/export-openapi.ts",
    "loadtest:smoke": "bun scripts/loadtest-acceptance.ts --mode smoke",
    "seed:demo": "bun scripts/seed-demo.ts",
    "auth:unlock": "bun scripts/auth-unlock.ts",
    "webhooks:reseal": "bun scripts/webhooks-reseal.ts",
    "webhooks:smoke": "bun scripts/webhook-transport-smoke.ts",
    "auth:reset-2fa": "bun scripts/auth-reset-2fa.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/client-sesv2": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "multer": "^2.3.0",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "24.0.0",
    "@types/supertest": "6.0.3",
    "aws-sdk-client-mock": "4.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.30.0",
    "jest": "30.5.1",
    "standardwebhooks": "1.1.1",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
